  "rules": {
    "explicitlyPreserved": [
      "verdict / overall / pass / detail / checks / exitCode",
      "所有 sha256 / fullHash / strippedHash / payload_sha256 值",
      "领域时间戳 price_ts / fetched_at / freshness_ms（哈希载荷的一部分，剥掉即销毁证据）",
      "stdout 正文与 stderr 正文（仅替换 PID 与绝对路径）"
    ],
    "serialization": "对象键名升序 + 2 空格缩进 + 末尾换行（stableStringify）",
    "strippedStringPatterns": [
      {
        "id": "stderr-node-pid",
        "pattern": "/\\(node:\\d+\\)/g",
        "replacement": "(node:<PID>)"
      },
      {
        "id": "abs-user-home-win",
        "pattern": "/[A-Za-z]:[\\\\/]Users[\\\\/][^\\\\/\\s\"',)]+/g",
        "replacement": "<USER_HOME>"
      },
      {
        "id": "abs-user-home-posix",
        "pattern": "/\\/(?:home|Users)\\/[^/\\s\"',)]+/g",
        "replacement": "<USER_HOME>"
      },
      {
        "id": "abs-unc",
        "pattern": "/\\\\\\\\[^\\s\"',)]+/g",
        "replacement": "<ABS_PATH>"
      },
      {
        "id": "abs-drive-path",
        "pattern": "/\\b[A-Za-z]:[\\\\/](?:[^\\\\/\\s\"',):]+[\\\\/])*[^\\\\/\\s\"',):]*/g",
        "replacement": "<ABS_PATH>"
      }
    ],
    "strippedTimeKeys": [
      "capturedAt",
      "completedAt",
      "createdAt",
      "finishedAt",
      "generatedAt",
      "startedAt",
      "updatedAt"
    ]
  },
  "scannedAtIsStripped": true,
  "schemaVersion": "1",
  "selfCheck": {
    "failures": [],
    "pass": true,
    "rule": "归一化前后 extractVerdict() 必须完全一致（确保没有因为剥离而改变结论）"
  },
  "sourceDir": "reports/evidence/v16",
  "tool": "apps/command_center_3d/scripts/normalize-evidence.mjs"
