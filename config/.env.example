# JCC Core control-plane config template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (gitignored).
# The bundled jcc.yaml already works with defaults; these env vars override.

# Shared secret for MUTATING control endpoints (POST /api/assess, /pause, /steer,
# /retry). Use a long random value. Required for those endpoints; read-only
# endpoints (health/sessions/audit/decisions) stay open by design.
JCC_CONTROL_TOKEN=

# Path to the config to run (optional; defaults to <repo>/config/jcc-v1.3.yaml,
# the v1.3 PRODUCT instance on port 4779 -- derived at runtime from the package
# location, so there is no hardcoded drive letter).
#
# The GREEN v1.0.1 baseline on port 4778 is a SEPARATE instance and is NOT the
# default: name config/jcc.yaml explicitly to run it (scripts/start.ps1 already
# does). A non-GREEN instance asking for 4778 is refused at startup, because a
# product process on the baseline's port is indistinguishable from the baseline
# to a health probe. See CR-002 in tools/cr002_green_port_falsifier.py.
JCC_CONFIG=

# Jev provider mode override: mock | disabled | real (optional; default from jcc.yaml).
JCC_PROVIDER=mock

# Real Jev API key — ONLY if JCC_PROVIDER=real AND jcc.yaml feature flag
# real_provider=true. Leave blank to stay on the deterministic mock (zero keys).
JEV_API_KEY=
